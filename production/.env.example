# Copy to .env.local for local work. Never commit real values.

# development | preview | production. On Vercel, NEXT_PUBLIC_VERCEL_ENV is used when unset.
# "production" requires NEXT_PUBLIC_SITE_URL and hides every pending (unconfirmed) fact.
NEXT_PUBLIC_SITE_ENV=development

# Confirmed canonical origin, e.g. https://<owner-confirmed-domain>. No trailing slash.
# Required when NEXT_PUBLIC_SITE_ENV=production. Not invented: owner input required.
NEXT_PUBLIC_SITE_URL=

# Google Maps Embed API browser key. It is visible in the browser by design, so it MUST be
# restricted in Google Cloud to the "Maps Embed API" and to the approved HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# report-only (default) | enforce. Trial the CSP as report-only before enforcing it.
CSP_MODE=report-only
