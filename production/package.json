{
  "name": "zippy-car-rental",
  "version": "1.0.0",
  "private": true,
  "description": "Zippy Car Rental — Phase 1 production frontend (Next.js App Router).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:report": "node --experimental-strip-types scripts/content-report.ts",
    "launch:check": "node --experimental-strip-types scripts/content-report.ts --launch",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@vercel/analytics": "^2.0.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.60.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "oxfmt": "0.74.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.3"
}
